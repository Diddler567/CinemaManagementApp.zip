-- =========================
-- SCHEMA FOR H2 (SNAKE_CASE)
-- =========================

DROP TABLE IF EXISTS screening_reviews;
DROP TABLE IF EXISTS screenings;
DROP TABLE IF EXISTS program_roles;
DROP TABLE IF EXISTS authentication_tokens;
DROP TABLE IF EXISTS programs;
DROP TABLE IF EXISTS audit_events;
DROP TABLE IF EXISTS users;

-- -------------------------
-- USERS
-- -------------------------
CREATE TABLE users (
    user_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    username VARCHAR(50) NOT NULL,
    fullname VARCHAR(120) NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    permanent_role VARCHAR(10) NOT NULL,
    is_active BOOLEAN NOT NULL,
    failed_auth_count INT NOT NULL,
    failed_password_change_count INT NOT NULL,
    CONSTRAINT uk_users_username UNIQUE (username)
);

-- -------------------------
-- PROGRAMS
-- -------------------------
CREATE TABLE programs (
    program_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    name VARCHAR(120) NOT NULL,
    description VARCHAR(500) NOT NULL,
    start_date DATE,
    end_date DATE,
    creation_date DATE NOT NULL,
    state VARCHAR(30) NOT NULL,
    creator_user_id BIGINT NOT NULL,
    CONSTRAINT uk_programs_name UNIQUE (name),
    CONSTRAINT fk_program_creator FOREIGN KEY (creator_user_id) REFERENCES users(user_id)
);

-- -------------------------
-- AUTH TOKENS
-- -------------------------
CREATE TABLE authentication_tokens (
    token_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    token_value VARCHAR(120) NOT NULL,
    user_id BIGINT NOT NULL,
    created_at TIMESTAMP NOT NULL,
    expires_at TIMESTAMP NOT NULL,
    is_valid BOOLEAN NOT NULL,
    CONSTRAINT uk_auth_token_value UNIQUE (token_value),
    CONSTRAINT fk_auth_token_user FOREIGN KEY (user_id) REFERENCES users(user_id)
);

-- -------------------------
-- PROGRAM ROLES (COMPOSITE PK)
-- -------------------------
CREATE TABLE program_roles (
    program_id BIGINT NOT NULL,
    user_id BIGINT NOT NULL,
    role VARCHAR(20) NOT NULL,
    assigned_at TIMESTAMP NOT NULL,
    CONSTRAINT pk_program_roles PRIMARY KEY (program_id, user_id),
    CONSTRAINT fk_programrole_program FOREIGN KEY (program_id) REFERENCES programs(program_id),
    CONSTRAINT fk_programrole_user FOREIGN KEY (user_id) REFERENCES users(user_id)
);

-- -------------------------
-- SCREENINGS
-- -------------------------
CREATE TABLE screenings (
    screening_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,

    program_id BIGINT NOT NULL,
    submitter_user_id BIGINT NOT NULL,
    handler_staff_user_id BIGINT,

    state VARCHAR(30) NOT NULL,
    creation_date TIMESTAMP NOT NULL,
    final_submission_at TIMESTAMP,

    approval_notes VARCHAR(500),
    rejection_reason VARCHAR(500),

    film_title VARCHAR(200) NOT NULL,
    film_cast VARCHAR(500),
    film_genre VARCHAR(100),
    film_duration INT NOT NULL,

    start_time TIMESTAMP,
    end_time TIMESTAMP,
    auditorium_name VARCHAR(100),

    CONSTRAINT fk_screening_program FOREIGN KEY (program_id) REFERENCES programs(program_id),
    CONSTRAINT fk_screening_submitter FOREIGN KEY (submitter_user_id) REFERENCES users(user_id),
    CONSTRAINT fk_screening_handler_staff FOREIGN KEY (handler_staff_user_id) REFERENCES users(user_id)
);

-- -------------------------
-- SCREENING REVIEWS
-- -------------------------
CREATE TABLE screening_reviews (
    review_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    screening_id BIGINT NOT NULL,
    staff_user_id BIGINT NOT NULL,
    score INT NOT NULL,
    comments VARCHAR(1000),
    review_at TIMESTAMP NOT NULL,
    CONSTRAINT fk_review_screening FOREIGN KEY (screening_id) REFERENCES screenings(screening_id),
    CONSTRAINT fk_review_staff FOREIGN KEY (staff_user_id) REFERENCES users(user_id)
);

-- -------------------------
-- AUDIT EVENTS
-- -------------------------
CREATE TABLE audit_events (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    timestamp TIMESTAMP,
    actor_user_id BIGINT,
    action VARCHAR(120),
    target_type VARCHAR(60),
    target_id BIGINT,
    details VARCHAR(2000),
    ip VARCHAR(64),
    method VARCHAR(10),
    path VARCHAR(300)
);


-- -------------------------
-- INDEXES
-- -------------------------
CREATE INDEX idx_programs_state ON programs(state);
CREATE INDEX idx_screenings_program ON screenings(program_id);
CREATE INDEX idx_screenings_state ON screenings(state);
CREATE INDEX idx_tokens_user ON authentication_tokens(user_id);
